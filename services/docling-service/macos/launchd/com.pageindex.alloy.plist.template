<?xml version="1.0" encoding="UTF-8"?>
<!-- Grafana Alloy launchd agent for the Mac docling-service (RFC-052 task 1.10).
     Rendered by install-logging.sh: every @PLACEHOLDER@ is substituted there.
     Alloy's own UI stays on loopback; it only pushes to Loki over Tailscale. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.pageindex.alloy</string>
  <key>ProgramArguments</key><array>
    <string>@ALLOY_BIN@</string>
    <string>run</string>
    <string>@CONFIG@</string>
    <string>--storage.path=@STORAGE@</string>
    <string>--server.http.listen-addr=127.0.0.1:12345</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>DOCLING_SERVICE_LOG</key><string>@SERVICE_LOG@</string>
    <key>LOKI_TAILSCALE_NODEPORT</key><string>@NODEPORT@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOG_DIR@/alloy.log</string>
  <key>StandardErrorPath</key><string>@LOG_DIR@/alloy.log</string>
</dict></plist>

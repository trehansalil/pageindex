# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
#
# When using docker-compose.yml, the only value you MUST set for the app
# containers is your OpenAI key; REDIS_URL / MINIO_ENDPOINT are overridden by
# compose to point at the local `redis` and `minio` services.

# ─── LLM (required) ──────────────────────────────────────────────────────────
# OPENAI_API_KEY (or CHATGPT_API_KEY) is required by the PageIndex library.
OPENAI_API_KEY=sk-your-openai-key-here
# CHATGPT_API_KEY=sk-...                       # alias; used if OPENAI_API_KEY unset
# LLM_PROVIDER=auto                            # auto|openai|compatible|azure (default auto)
# OPENAI_BASE_URL=https://api.openai.com/v1    # OpenAI API endpoint or OpenAI-compatible endpoint (vLLM/Together/Groq/OpenRouter/local)
# AZURE_API_VERSION=2024-08-01-preview         # only when using Azure (e.g., https://myresource.openai.azure.com/)

# Model selection. Defaults work with plain OpenAI; set PAGEINDEX_MODEL=azure/<deployment> for Azure ingestion.
# PAGEINDEX_MODEL=gpt-4o-2024-11-20
# PAGEINDEX_FILTER_MODEL=gpt-4o-mini
# PAGEINDEX_SEARCH_MODEL=gpt-4o-mini
# PAGEINDEX_SEARCH_CONCURRENCY=3

# LLM resilience — fallback endpoint and retry control for tree-building calls.
# LLM_TREE_MAX_RETRIES=3                       # max LLM retries per tree-build attempt (default 3)
# LLM_FALLBACK_BASE_URL=                       # secondary OpenAI-compatible endpoint; used when primary fails

# ─── Langfuse tracing (optional, LLM-02) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...                 # project public key; tracing activates ONLY when both keys set (unset = disabled, zero overhead)
LANGFUSE_SECRET_KEY=sk-lf-...                 # project secret key
LANGFUSE_HOST=https://cloud.langfuse.com      # EU region (default); US = https://us.cloud.langfuse.com
LANGFUSE_TRACE_CONTENT=false                  # false = mask prompt/completion bodies before export (usage+cost still recorded); true captures full content. WARNING: true exports document text to Langfuse Cloud — inappropriate for PII corpora

# ─── Auth ────────────────────────────────────────────────────────────────────
UPLOAD_API_KEY=dev-api-key       # required by POST /upload/files (X-API-Key header)
MCP_BEARER_TOKEN=dev-api-key     # Authorization: Bearer <token> on /mcp; empty = 503 unless MCP_ALLOW_UNAUTHENTICATED=true (RFC-011 D4 fail-closed default)
MCP_ALLOW_UNAUTHENTICATED=false  # explicit opt-in to run /mcp with no auth (dev/trusted-network only) when MCP_BEARER_TOKEN is empty
PII_CORPUS=false                 # true = corpus contains PII; server refuses to start unless OPENAI_BASE_URL is on the ZDR allow-list (Azure *.openai.azure.com, AWS bedrock-runtime.*, OpenAI eu.api.openai.com) — RFC-011 D6 / ISS-33 / HR3

# ─── Redis ───────────────────────────────────────────────────────────────────
# For host-run app against the compose Redis:  redis://localhost:6379/1
# Inside compose this is overridden to redis://redis:6379/1.
REDIS_URL=redis://localhost:6379/1
CACHE_TTL=300

# ─── MinIO ───────────────────────────────────────────────────────────────────
# For host-run app against the compose MinIO:  localhost:9000
# Inside compose this is overridden to minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pageindex
MINIO_SECURE=false
# MINIO_REGION=                                # S3 region for the bucket (default empty)
# MINIO_PATH_PREFIX=                           # virtual path prefix inside the bucket (e.g. tenant isolation)
# MINIO_PRESIGN_ENDPOINT=                      # public-facing endpoint for pre-signed URLs (when behind a reverse proxy / Traefik)
# MINIO_PRESIGN_SECURE=true                    # use HTTPS for pre-signed URLs (default true)
# MINIO_PRESIGN_PATH_PREFIX=                   # path prefix to splice into pre-signed URLs (Traefik StripPrefix compat)

# ─── OCR / tessdata (Fix-3 garble escalation, Fix-5 language detect) ──────────
# OCR is local Tesseract only (no LLM egress — PII-safe, HR3). The garble-retry
# path auto-detects language (filename + text sample) so Arabic gazettes get 'ara'.
# DOCLING_DO_OCR=0                  # 1 = OCR every PDF page; default 0 (only the garble retry / images OCR)
# DOCLING_OCR_LANG=deu,eng         # static fallback lang list when auto-detect yields nothing
# OCR_ESCALATION=1                  # 1 (default) = one force_full_page_ocr retry when a PDF garbles
# TESSDATA_ALLOW_DOWNLOAD=0        # 1 = fetch missing <lang>.traineddata at runtime; 0 (default) = pre-baked only
# TESSDATA_PREFIX=                  # dir holding <lang>.traineddata. Empty = trust the system tesseract
#                                   # install (e.g. brew's /opt/homebrew/share/tessdata, which has ara).
#                                   # For egress-limited workers, PRE-BAKE first then point here:
#                                   #   scripts/prebake_tessdata.sh        # bakes ara,eng,deu,osd into .tessdata/
#                                   #   TESSDATA_PREFIX=/app/.tessdata
#                                   # NOTE: when TESSDATA_PREFIX is set, ALL needed langs must be present there
#                                   # (a missing lang is dropped, not fetched) — bake eng/deu too, not just ara.
# DOCLING_FORCE_FULL_PAGE_OCR=0    # 1 = force OCR on every page regardless of text layer (debugging aid)
# PRE_GARBLE_FORCE_OCR_ENABLED=false  # true = force OCR before garble detection (experimental)

# ─── PDF conversion & flat-doc routing ────────────────────────────────────────
# PDF_CONVERTER=docling             # docling (default, MIT-clean) | pymupdf4llm (AGPL-3.0, faster)
# DOCLING_ARTIFACTS_PATH=           # dir of pre-downloaded Docling model weights (offline/egress-limited use)
# DOCLING_NUM_THREADS=1             # Docling intra-op thread cap; raise only where the node has RAM headroom
# FLAT_DOC_ROUTING=true             # true (default) = route depth<2/node_count<3 docs to the flat success path
# MAX_DOCLING_PAGES=150             # page-count threshold for chunked-Docling routing (RFC-027 D7)

# ─── Remote Docling service (alternative to local Docling) ────────────────────
# DOCLING_SERVICE_URL=              # URL of remote Docling HTTP service; empty = use local Docling
# DOCLING_SERVICE_TIMEOUT_S=600    # timeout for remote Docling calls (default 600s)
# DOCLING_SERVICE_BEARER_TOKEN=    # Bearer token for remote Docling service auth

# ─── pdf-inspector shadow mode (RFC-031) ──────────────────────────────────────
# Shadow-mode PDF classifier: runs in probe_conversion_route(), logs type/confidence
# to Prometheus, but NEVER influences routing. validate_tree() remains sole gate.
# PDF_INSPECTOR_PRECLASSIFY=0      # reserved for Phase 2 promotion; 1 = let classification influence routing (NOT YET SAFE)

# ─── VLM fallback (optional, RFC-004 Approach B) ─────────────────────────────
# Last-resort vision-model extraction for garble-rejected PDFs whose OCR
# escalation also failed (e.g. scanned docs with watermark-only text layers).
# VLM_FALLBACK=false                # true = enable VLM last-resort fallback
# VLM_MODEL=gpt-4.1                # vision-capable model name (must support image_url content)
# VLM_DESCRIBE_IMAGES=false        # true = use VLM to describe images inline during conversion
# VLM_TESSERACT_FALLBACK_ENABLED=true  # true = fall back to Tesseract OCR when VLM fails on an image region

# ─── Image & picture handling ─────────────────────────────────────────────────
# TREE_PATH_PICTURE_SPLICE_ENABLED=true        # true = splice picture descriptions into tree paths (default true)
# PICTURE_PAGE_COVERAGE_THRESHOLD=0.6          # fraction of page area a picture must cover to be classified as full-page (default 0.6)
# DECORATIVE_ICON_MIN_DIM_PT=20               # min dimension in points below which images are treated as decorative icons (default 20)
# IMAGE_ENRICH_CONCURRENCY=4                  # max concurrent image-enrichment (VLM/OCR) calls per document (default 4)
# COVERAGE_EXEMPT_NO_TEXT_LAYER=               # exempt pages with no text layer from coverage threshold
# CLIP_TEXT_CAPTURE_ENABLED=true               # true = capture clipped text from PDF operators (default true)
# STRIP_SKIPPED_IMAGE_MARKERS=true             # true = remove [skipped image] markers from final output (default true)
# IMAGE_STANDALONE_PIPELINE_ENABLED=true       # true = standalone image processing pipeline (default true)
# MIN_STANDALONE_IMAGE_MD_CHARS=100            # min markdown chars for standalone image output (default 100)
# IMAGE_DOMINANT_OCR_ESCALATION_ENABLED=true   # true = escalate to OCR for image-dominant pages (default true)
# MIN_IMAGE_PROMOTED_CHARS=500                 # min chars for image-promoted content (default 500)

# ─── Garble detection & quality gate (validate_tree heuristics) ───────────────
# Fine-tune the garble/quality heuristics in validate_tree(). These are expert
# knobs — defaults are calibrated for the German insurance T&C corpus. Changing
# them without corpus-level regression testing is risky.
# GARBLE_LATIN_GIBBERISH_ENABLED=true          # enable Latin-script gibberish detector (default true)
# GARBLE_LATIN_RATIO=0.4                       # ratio threshold for Latin gibberish detection (default 0.4)
# GARBLE_NONSENSE_RATIO=0.7                    # ratio threshold for nonsense-word detection (default 0.7)
# GARBLE_NODE_RATIO_THRESHOLD=0.10             # fraction of garbled nodes that triggers document-level garble (default 0.10)
# GARBLE_WINDOW_RATIO_THRESHOLD=0.05           # sliding-window garble ratio threshold (default 0.05)
# GARBLE_SHORT_TEXT_DEFAULT=true               # default garble verdict for very short text samples (default true)
# EMPTY_NODE_FRACTION_THRESHOLD=               # fraction of empty nodes triggering low-quality rejection
# BIDI_COHERENCE_ENFORCE=false                 # true = enforce BiDi coherence checks (default false)
# LOW_CONTENT_OCR_CHAR_FLOOR=300               # char count below which OCR escalation triggers (default 300)
# TEXT_LAYER_GARBLE_CHECK_ENABLED=              # enable text-layer-specific garble checking
# REGION_AWARE_TEXT_CHECK_ENABLED=              # enable region-aware text quality checking
# MAX_FULLPAGE_PICTURE_OCR_REGIONS=50          # max OCR regions per full-page picture (default 50)
# PAGE_ROTATION_DETECTION_ENABLED=             # enable page rotation detection heuristic

# ─── Flat-doc & tree promotion heuristics (RFC-029) ───────────────────────────
# PASS_MAX_LEAF_RATIO=0.30                     # max leaf-node ratio for tree pass (default 0.30)
# PASS_HYSTERESIS_BAND=0.10                    # hysteresis band around leaf-ratio threshold (default 0.10)
# MIN_FLAT_PROMOTION_CHARS=500                 # min chars for flat-doc promotion (default 500)
# SMALL_DOC_PROMOTION_ENABLED=true             # true = promote small docs to flat path (default true)
# LEAF_CONCENTRATION_PARAGRAPH_SPLIT_ENABLED=true  # true = split paragraphs on leaf concentration (default true)
# RFC029_FLAT_PREFER_MULTIPLIER=3.0            # flat-doc preference multiplier for scoring (default 3.0)
# RFC029_MIN_CHARS_PER_NODE=150                # min chars-per-node for tree quality (default 150 in helpers.py, 500 in client.py — see NOTE below)
# RFC029_MIN_SCANNED_DENSITY_FLOOR=1500        # min char density floor for scanned-doc detection (default 1500)
# RFC029_TABLE_DEDUP_ENABLED=1                 # 1 = enable table deduplication (default 1)
# RFC029_TABLE_MIN_COLLAPSE_COLS=3             # min columns for table collapse (default 3)
# RFC029_TABLE_SEGMENT_CHAR_THRESHOLD=2000     # char threshold for table segment splitting (default 2000)
# RFC029_TABLE_SEGMENT_MIN_ROWS=5              # min rows for table segment (default 5)
# D7_GARBLE_RECOVERY_ENABLED=true              # true = enable D7 garble recovery path (default true)
# D7_FITZ_FALLBACK_ENABLED=true                # true = enable fitz fallback for D7 (default true)
#
# NOTE: RFC029_MIN_CHARS_PER_NODE has inconsistent defaults across modules:
#   helpers.py defaults to 150, client.py defaults to 500. Set it explicitly to
#   avoid ambiguity. This will be unified in a future fix.

# ─── Memory admission (worker backpressure) ───────────────────────────────────
# MEM_ADMISSION_FLOOR_BYTES=2300000000  # min free RAM required before starting a job (default ~2.3GB)
# MEM_ADMISSION_MAX_WAIT_S=120          # max seconds to wait for headroom before proceeding anyway
# MEM_ADMISSION_POLL_S=3                # polling interval while waiting for headroom

# ─── Worker ──────────────────────────────────────────────────────────────────
# PAGEINDEX_WORKER_MAX_JOBS=              # max concurrent arq jobs per worker process

# ─── Observability ─────────────────────────────────────────────────────────────
# ARQ_QUEUE_DEPTH_SCRAPE_INTERVAL_S=5   # arq queue-depth Prometheus scrape interval
# PAGEINDEX_REGISTRY_METRICS_SYNC_INTERVAL_S=5  # Redis→Prometheus registry metric sync interval (default 5s)

# ─── Server ──────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8201
WEB_CONCURRENCY=1                # keep at 1 — MCP sessions are in-memory per worker

# ─── Document registry (RFC-006, corpus-scale candidate narrowing) ─────────────
# POSTGRES_DSN targets the compose `postgres` service; use localhost:5432 for
# host-run processes, postgres:5432 from inside the compose network.
# REGISTRY_ENABLED=false bypasses all registry code (behaves as pre-RFC-006).
POSTGRES_DSN=postgresql://pageindex:pageindex@localhost:5432/pageindex
REGISTRY_ENABLED=true
PAGEINDEX_CATALOG_TOPK=200        # Stage B BM25 (ts_rank) cut-off before LLM prefilter
# PAGEINDEX_REGISTRY_QUERY_CONCURRENCY=15       # max concurrent registry queries (default 15)
# PAGEINDEX_REGISTRY_RECONCILE_INTERVAL_S=1200  # registry reconcile loop interval in seconds (default 1200)
# REGISTRY_DELETE_TIMEOUT_S=5.0                 # timeout for registry delete operations (default 5.0s)
# MAX_UPLOAD_SIZE_MB=100                        # max file size for uploads in MB (default 100)

# ─── Confluence doc sync (make confluence-sync, scripts/confluence_sync.sh) ────
# CONFLUENCE_URL=https://your-org.atlassian.net/wiki
# CONFLUENCE_USER=you@your-org.com
# CONFLUENCE_API_TOKEN=your-atlassian-api-token

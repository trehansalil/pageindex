# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
#
# When using docker-compose.yml, the only value you MUST set for the app
# containers is your OpenAI key; REDIS_URL / MINIO_ENDPOINT are overridden by
# compose to point at the local `redis` and `minio` services.

# ─── LLM (required) ──────────────────────────────────────────────────────────
# OPENAI_API_KEY (or CHATGPT_API_KEY) is required by the PageIndex library.
OPENAI_API_KEY=sk-your-openai-key-here
# CHATGPT_API_KEY=sk-...                       # alias; used if OPENAI_API_KEY unset
# LLM_PROVIDER=auto                            # auto|openai|compatible|azure (default auto)
# OPENAI_BASE_URL=https://api.openai.com/v1    # OpenAI API endpoint or OpenAI-compatible endpoint (vLLM/Together/Groq/OpenRouter/local)
# AZURE_API_VERSION=2024-08-01-preview         # only when using Azure (e.g., https://myresource.openai.azure.com/)
# LLM_FALLBACK_BASE_URL=                       # fallback LLM endpoint when primary is unreachable
# LLM_TREE_MAX_RETRIES=3                       # max LLM retries for tree generation

# Model selection. Defaults work with plain OpenAI; set PAGEINDEX_MODEL=azure/<deployment> for Azure ingestion.
# PAGEINDEX_MODEL=gpt-4o-2024-11-20
# PAGEINDEX_FILTER_MODEL=gpt-4o-mini
# PAGEINDEX_SEARCH_MODEL=gpt-4o-mini
# PAGEINDEX_SEARCH_CONCURRENCY=3

# ─── Langfuse tracing (optional, LLM-02) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...                 # project public key; tracing activates ONLY when both keys set (unset = disabled, zero overhead)
LANGFUSE_SECRET_KEY=sk-lf-...                 # project secret key
LANGFUSE_HOST=https://cloud.langfuse.com      # EU region (default); US = https://us.cloud.langfuse.com
LANGFUSE_TRACE_CONTENT=false                  # false = mask prompt/completion bodies before export (usage+cost still recorded); true captures full content. WARNING: true exports document text to Langfuse Cloud — inappropriate for PII corpora

# ─── Auth ────────────────────────────────────────────────────────────────────
UPLOAD_API_KEY=dev-api-key       # required by POST /upload/files (X-API-Key header)
MCP_BEARER_TOKEN=dev-api-key     # Authorization: Bearer <token> on /mcp; empty = 503 unless MCP_ALLOW_UNAUTHENTICATED=true (RFC-011 D4 fail-closed default)
MCP_ALLOW_UNAUTHENTICATED=false  # explicit opt-in to run /mcp with no auth (dev/trusted-network only) when MCP_BEARER_TOKEN is empty
PII_CORPUS=false                 # true = corpus contains PII; server refuses to start unless OPENAI_BASE_URL is on the ZDR allow-list (Azure *.openai.azure.com, AWS bedrock-runtime.*, OpenAI eu.api.openai.com) — RFC-011 D6 / ISS-33 / HR3

# ─── Redis ───────────────────────────────────────────────────────────────────
# For host-run app against the compose Redis:  redis://localhost:6379/1
# Inside compose this is overridden to redis://redis:6379/1.
REDIS_URL=redis://localhost:6379/1
CACHE_TTL=300

# ─── MinIO ───────────────────────────────────────────────────────────────────
# For host-run app against the compose MinIO:  localhost:9000
# Inside compose this is overridden to minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pageindex
MINIO_SECURE=false
# MINIO_REGION=                                # MinIO region (leave empty for default)
# MINIO_PATH_PREFIX=                           # path prefix for all MinIO object keys
# MINIO_PRESIGN_ENDPOINT=                      # separate endpoint for presigned URLs (e.g. public-facing host)
# MINIO_PRESIGN_PATH_PREFIX=                   # path prefix for presigned URL keys
# MINIO_PRESIGN_SECURE=true                    # use HTTPS for presigned URLs
# SSL_CERT_FILE=                               # custom CA cert bundle for MinIO TLS connections

# ─── OCR / tessdata (Fix-3 garble escalation, Fix-5 language detect) ──────────
# OCR is local Tesseract only (no LLM egress — PII-safe, HR3). The garble-retry
# path auto-detects language (filename + text sample) so Arabic gazettes get 'ara'.
# DOCLING_DO_OCR=0                  # 1 = OCR every PDF page; default 0 (only the garble retry / images OCR)
# DOCLING_OCR_LANG=deu,eng         # static fallback lang list when auto-detect yields nothing
# OCR_ESCALATION=1                  # 1 (default) = one force_full_page_ocr retry when a PDF garbles
# TESSDATA_ALLOW_DOWNLOAD=0        # 1 = fetch missing <lang>.traineddata at runtime; 0 (default) = pre-baked only
# TESSDATA_PREFIX=                  # dir holding <lang>.traineddata. Empty = trust the system tesseract
#                                   # install (e.g. brew's /opt/homebrew/share/tessdata, which has ara).
#                                   # For egress-limited workers, PRE-BAKE first then point here:
#                                   #   scripts/prebake_tessdata.sh        # bakes ara,eng,deu,osd into .tessdata/
#                                   #   TESSDATA_PREFIX=/app/.tessdata
#                                   # NOTE: when TESSDATA_PREFIX is set, ALL needed langs must be present there
#                                   # (a missing lang is dropped, not fetched) — bake eng/deu too, not just ara.
# LOW_CONTENT_OCR_CHAR_FLOOR=300    # min chars to consider a page as having content (below triggers OCR escalation)

# ─── Garble detection tuning ─────────────────────────────────────────────────
# GARBLE_LATIN_GIBBERISH_ENABLED=true           # detect Latin-script gibberish in text layers
# GARBLE_LATIN_RATIO=0.4                        # fraction of garbled Latin chars to flag a block
# GARBLE_NONSENSE_RATIO=0.7                     # fraction of nonsense tokens to flag a block
# GARBLE_NODE_RATIO_THRESHOLD=0.10              # fraction of garbled nodes to reject the whole tree
# GARBLE_WINDOW_RATIO_THRESHOLD=0.05            # sliding-window garble ratio threshold
# GARBLE_SHORT_TEXT_DEFAULT=true                 # treat short/ambiguous text as garbled by default
# TEXT_LAYER_GARBLE_CHECK_ENABLED=true           # check PDF text layer for garble before accepting
# PRE_GARBLE_FORCE_OCR_ENABLED=false             # force OCR before garble check (expensive, usually off)
# BIDI_COHERENCE_ENFORCE=false                   # enforce bidirectional text coherence (Arabic/Hebrew)

# ─── PDF conversion & flat-doc routing ────────────────────────────────────────
# PDF_CONVERTER=docling             # docling (default, MIT-clean) | pymupdf4llm (AGPL-3.0, faster)
# DOCLING_ARTIFACTS_PATH=           # dir of pre-downloaded Docling model weights (offline/egress-limited use)
# DOCLING_NUM_THREADS=1             # Docling intra-op thread cap; raise only where the node has RAM headroom
# DOCLING_FORCE_FULL_PAGE_OCR=0     # 1 = force full-page OCR on every Docling conversion
# FLAT_DOC_ROUTING=true             # true (default) = route depth<2/node_count<3 docs to the flat success path
# PDF_INSPECTOR_PRECLASSIFY=0       # 1 = pre-classify PDF type before conversion (experimental)
# MAX_DOCLING_PAGES=150             # max pages Docling will process per document

# ─── Remote Docling service ──────────────────────────────────────────────────
# DOCLING_SERVICE_URL=              # remote Docling service endpoint (leave empty for local conversion)
# DOCLING_SERVICE_BEARER_TOKEN=     # auth token for remote Docling service
# DOCLING_SERVICE_TIMEOUT_S=600     # timeout in seconds for remote Docling calls
# HF_TOKEN=                         # HuggingFace token for downloading model weights

# ─── VLM fallback (optional, RFC-004 Approach B) ─────────────────────────────
# Last-resort vision-model extraction for garble-rejected PDFs whose OCR
# escalation also failed (e.g. scanned docs with watermark-only text layers).
# VLM_FALLBACK=false                # true = enable VLM last-resort fallback
# VLM_MODEL=gpt-4.1                # vision-capable model name (must support image_url content)
# VLM_DESCRIBE_IMAGES=false         # true = use VLM to describe images in documents
# VLM_TESSERACT_FALLBACK_ENABLED=true  # fall back to Tesseract OCR when VLM is unavailable

# ─── Image enrichment & picture pipeline ──────────────────────────────────────
# IMAGE_ENRICH_CONCURRENCY=4                    # max concurrent image enrichment tasks per document
# IMAGE_STANDALONE_PIPELINE_ENABLED=true         # enable standalone image extraction pipeline
# IMAGE_DOMINANT_OCR_ESCALATION_ENABLED=true     # escalate to OCR when image dominates page content
# CLIP_TEXT_CAPTURE_ENABLED=true                 # capture CLIP text embeddings from images
# COVERAGE_EXEMPT_NO_TEXT_LAYER=true             # exempt pages without text layer from coverage checks
# DECORATIVE_ICON_MIN_DIM_PT=20                 # min dimension (pt) to distinguish icons from real images
# MAX_FULLPAGE_PICTURE_OCR_REGIONS=50            # max OCR regions per full-page picture
# PICTURE_PAGE_COVERAGE_THRESHOLD=0.6            # fraction of page area an image must cover to be "dominant"
# REGION_AWARE_TEXT_CHECK_ENABLED=true            # check text presence per region, not just whole page
# STRIP_SKIPPED_IMAGE_MARKERS=true               # remove <!-- image --> markers from output
# TREE_PATH_PICTURE_SPLICE_ENABLED=true          # splice picture content into tree paths
# MIN_IMAGE_PROMOTED_CHARS=500                   # min chars for image-extracted text to be promoted to tree
# MIN_STANDALONE_IMAGE_MD_CHARS=100              # min markdown chars for standalone image output

# ─── Tree quality & flat-doc tuning ──────────────────────────────────────────
# EMPTY_NODE_FRACTION_THRESHOLD=0.5              # max fraction of empty nodes before tree is rejected
# LEAF_CONCENTRATION_PARAGRAPH_SPLIT_ENABLED=true  # split concentrated leaf paragraphs for better structure
# MIN_FLAT_PROMOTION_CHARS=500                   # min chars for flat-doc content to be promoted
# SMALL_DOC_PROMOTION_ENABLED=true               # promote small documents to flat success path
# PASS_MAX_LEAF_RATIO=0.30                       # max leaf-node ratio for PASS verdict
# PASS_HYSTERESIS_BAND=0.10                      # hysteresis band around PASS/MARGINAL threshold
# PAGE_ROTATION_DETECTION_ENABLED=true            # detect and correct rotated pages

# ─── RFC-029 tuning knobs ────────────────────────────────────────────────────
# RFC029_FLAT_PREFER_MULTIPLIER=3.0              # multiplier favoring flat route when tree is shallow
# RFC029_MIN_CHARS_PER_NODE=500                  # min chars per node for tree quality
# RFC029_MIN_SCANNED_DENSITY_FLOOR=1500          # min char density floor for scanned documents
# RFC029_TABLE_DEDUP_ENABLED=1                   # 1 = deduplicate table content across nodes
# RFC029_TABLE_MIN_COLLAPSE_COLS=3               # min columns to trigger table collapse
# RFC029_TABLE_SEGMENT_CHAR_THRESHOLD=2000       # char threshold for table segmentation
# RFC029_TABLE_SEGMENT_MIN_ROWS=5                # min rows for table segmentation

# ─── D7 recovery (fitz fallback & garble recovery) ───────────────────────────
# D7_FITZ_FALLBACK_ENABLED=true     # enable PyMuPDF (fitz) fallback when Docling fails
# D7_GARBLE_RECOVERY_ENABLED=true   # enable garble recovery pipeline

# ─── Memory admission (worker backpressure) ───────────────────────────────────
# MEM_ADMISSION_FLOOR_BYTES=2300000000  # min free RAM required before starting a job (default ~2.3GB)
# MEM_ADMISSION_MAX_WAIT_S=120          # max seconds to wait for headroom before proceeding anyway
# MEM_ADMISSION_POLL_S=3                # polling interval while waiting for headroom

# ─── Observability ─────────────────────────────────────────────────────────────
# ARQ_QUEUE_DEPTH_SCRAPE_INTERVAL_S=5   # arq queue-depth Prometheus scrape interval
# LOG_LEVEL=info                         # log level: debug|info|warning|error|critical

# ─── Server ──────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8201
WEB_CONCURRENCY=1                # keep at 1 — MCP sessions are in-memory per worker
# MAX_UPLOAD_SIZE_MB=100          # max upload file size in MB
# PAGEINDEX_WORKER_MAX_JOBS=10    # max concurrent arq worker jobs
# PREPROCESS_CONCURRENCY=1        # max concurrent preprocess_client.py batch jobs

# ─── Document registry (RFC-006, corpus-scale candidate narrowing) ─────────────
# POSTGRES_DSN targets the compose `postgres` service; use localhost:5432 for
# host-run processes, postgres:5432 from inside the compose network.
# REGISTRY_ENABLED=false bypasses all registry code (behaves as pre-RFC-006).
POSTGRES_DSN=postgresql://pageindex:pageindex@localhost:5432/pageindex
REGISTRY_ENABLED=true
PAGEINDEX_CATALOG_TOPK=200        # Stage B BM25 (ts_rank) cut-off before LLM prefilter
# REGISTRY_DELETE_TIMEOUT_S=5.0                  # timeout for registry delete operations
# PAGEINDEX_REGISTRY_QUERY_CONCURRENCY=15        # max concurrent registry queries
# PAGEINDEX_REGISTRY_RECONCILE_INTERVAL_S=1200   # interval between registry reconciliation sweeps
# PAGEINDEX_REGISTRY_METRICS_SYNC_INTERVAL_S=5   # interval for syncing registry metrics to Prometheus

# ─── Confluence doc sync (make confluence-sync, scripts/confluence_sync.sh) ────
# CONFLUENCE_URL=https://your-org.atlassian.net/wiki
# CONFLUENCE_USER=you@your-org.com
# CONFLUENCE_API_TOKEN=your-atlassian-api-token

# ─── Test / stress test (development only) ───────────────────────────────────
# TEST_MCP_URL=http://localhost:8201/mcp          # MCP endpoint for test suite
# STRESS_TEST_BASE_URL=https://pageindex.aiwithsalil.work  # base URL for stress tests
# STRESS_TEST_MCP_PATH=/mcp                       # MCP path suffix for stress tests

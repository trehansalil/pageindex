# env/local.env — the "local" side of every toggle.
#
# These are the docker-compose.yml service defaults, reachable from your host
# once `make compose-infra` (or `docker compose up -d`) is running. Committed to
# git on purpose: nothing here is a real secret, they are the same throwaway
# credentials docker-compose.yml already defaults to.
#
# The "remote" side lives in env/remote.env, which is generated by
# `make env-remote` and gitignored because it does hold real credentials.
#
# scripts/env_profile.sh reads both and resolves them into .env.active.

PI_LOCAL_MINIO_ENDPOINT=localhost:9000
PI_LOCAL_MINIO_ACCESS_KEY=minioadmin
PI_LOCAL_MINIO_SECRET_KEY=minioadmin
PI_LOCAL_MINIO_SECURE=false

# Host the local Docling container uses to fetch staged files. Only relevant
# when PI_MINIO=local AND PI_DOCLING=local:
#   - both in compose        -> minio:9000        (compose network DNS)
#   - app on host, docling in compose -> 172.17.0.1:9000 (docker bridge gateway)
# Left empty by default; env_profile.sh fills in the right one from PI_APP.
PI_LOCAL_MINIO_PRESIGN_ENDPOINT=
PI_LOCAL_MINIO_PRESIGN_SECURE=false

PI_LOCAL_REDIS_URL=redis://localhost:6379/1
PI_LOCAL_POSTGRES_DSN=postgresql://pageindex:pageindex@localhost:5432/pageindex

PI_LOCAL_DOCLING_URL=http://localhost:8080
# The local docling-service container accepts whatever token you set in .env;
# empty means "no auth", which is what services/docling-service does by default.
PI_LOCAL_DOCLING_TOKEN=

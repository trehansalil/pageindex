+// Identity key for a candidate. Agents label the same symbol inconsistently across
+// rounds ("X", "X (facade re-export)", "X (re-export from worker package facade)",
+// '"X" entry in pkg/__init__.py __all__'), so strip trailing parentheticals and
+// surrounding quotes before keying. Run 6 lost 6 skeptic-refuted items to this:
+// they re-entered the confirmed set through the cascade round under a new label.
+const normName = n => {
+  const raw = String(n == null ? '' : n).trim()
+  // An __all__ string entry is a DIFFERENT line to delete than its import, so it
+  // must key separately -- do not collapse the two into one candidate.
+  const suffix = /__all__/.test(raw) ? '#__all__' : ''
+  const bare = raw
+    .replace(/^["'`]([^"'`]+)["'`].*$/, '$1')  // '"X" entry in pkg/__init__.py __all__' -> X
+    .replace(/\s*\([^)]*\)\s*$/, '')          // 'X (facade re-export)' -> X
+    .replace(/^["'`]|["'`]$/g, '')
+    .trim()
+  return bare + suffix
+}
+const keyOf = c => `${c.file}::${normName(c.name)}`
+const lineKey = c => (c.start_line ? `${c.file}#${c.start_line}` : null)

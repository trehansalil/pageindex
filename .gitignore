# TESSDATA_PREFIX at this dir. Model blobs (~30 MB), not source; never committed.
.tessdata/
# Local agent/tool dirs and throwaway probe logs (RFC-004 Phase 0)
.claude/
.kiro/
issue/phase0_*.log
# make confluence-sync change-detection stamp (local only, not shared state)
.agents/.confluence-sync.stamp

# Obsidian editor config (per-developer, not project source)
.obsidian/

# Vercel build output (CI-generated from docs/corpus-quality-cycle.html)
docs/public/
docs/.vercel/
.DS_Store

# Generated by scripts/make_remote_env.sh — contains cluster credentials
.env.remote
env/remote.env
# Generated by scripts/env_profile.sh — resolved copy of .env, so also secret
.env.active
# Persisted local/remote toggle choices; per-developer, not shared
env/profile.env
audit/ingest-runs/
.run/
# Per-developer connection settings for the local/remote toggles. Every file in
# here holds endpoints and credentials for someone's own infra — env_profile.sh
# reads them, nothing shares them. See docs/ENV_PROFILES.md to write your own.
env/
# Per-document ingestion results written by scripts/remote_ingest_test.py.
# Derived corpus data: keep it purgeable, and out of the repo.
logs/

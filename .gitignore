doc_store/
.env
.venv/
__pycache__/
*.pyc
preprocess.log
.worktrees/
.coverage
coverage.xml
# Tesseract language models (deu/eng/osd) for the Docling OCR path — point
# TESSDATA_PREFIX at this dir. Model blobs (~30 MB), not source; never committed.
.tessdata/
# Local agent/tool dirs and throwaway probe logs (RFC-004 Phase 0).
.claude/
.kiro/
issue/phase0_*.log
# make confluence-sync change-detection stamp (local only, not shared state)
.agents/.confluence-sync.stamp

# Obsidian editor config (per-developer, not project source)
.obsidian/

# Vercel build output (CI-generated from docs/corpus-quality-cycle.html)
docs/public/
docs/.vercel/
.DS_Store

.env.remote
# Generated by scripts/env_profile.sh — resolved copy of .env, so also secret
.env.active
audit/ingest-runs/
.run/
# Per-developer connection settings for the local/remote toggles: env/remote.env
# holds real cluster credentials (generated by make env-remote) and
# env/profile.env holds someone's own toggle choices. Ignore the directory, but
# NOT env/local.env — that one is the committed "local" side of every toggle,
# and scripts/env_profile.sh requires it on every profile. It contains only the
# docker-compose defaults (localhost, minioadmin), never a real secret.
env/*
!env/local.env
# Per-document ingestion results written by scripts/remote_ingest_test.py.
# Derived corpus data: keep it purgeable, and out of the repo.
logs/
